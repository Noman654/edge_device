+    // Fuse UNARY_GELU followed by MUL into the existing two-operand GEGLU kernel:
+    //   geglu(x, g) = gelu(x) * g
+    //
+    // Gemma-4's per-layer-embedding gate is hand-rolled in gemma4.cpp as ggml_gelu()
+    // followed by ggml_mul() (35 pairs per token), whereas build_ffn() emits
+    // ggml_geglu_split() and reaches the fused kernel directly. Fusing here saves one
+    // dispatch per layer and, more importantly, routes the activation through the
+    // tanh-form GELU implemented by the GEGLU kernel (bit-for-bit the CPU reference
+    // formula) instead of the quick x*sigmoid(1.702x) approximation used by the
+    // standalone HTP_OP_UNARY_GELU kernel.
+    bool try_fuse_gelu_mul(const htp_opnode & node) {
+        if (n_ops == 0) return false;
+        if (node.opcode != HTP_OP_MUL) return false;
+
+        htp_opnode & last_node = ops[n_ops - 1];
+        if (last_node.opcode != HTP_OP_UNARY_GELU) return false;
+        if (!last_node.fused.empty()) return false;
+
+        const ggml_tensor * mul_src0 = node.src0();
+        const ggml_tensor * mul_src1 = node.src1();
+        const ggml_tensor * gelu_out = last_node.dst();
+
+        if (!mul_src0 || !mul_src1 || !gelu_out) return false;
+        if (!ggml_hexagon_tensor_is_fuseable(gelu_out)) return false;
+
+        const ggml_tensor * gate = nullptr; // second GEGLU operand
+        if (mul_src0 == gelu_out || mul_src0->data == gelu_out->data) {
+            gate = mul_src1;
+        } else if (mul_src1 == gelu_out || mul_src1->data == gelu_out->data) {
+            gate = mul_src0;
+        } else {
+            return false;
+        }
+        if (!gate || !gate->data) return false;
+
+        const ggml_tensor * src0 = last_node.src0(); // GELU input
+        const ggml_tensor * dst  = node.dst();
+        if (!src0 || !src0->data || !dst) return false;
+
+        // Mirror ggml_hexagon_supported_activations() for the two-operand GLU form.
+        if (src0->type != GGML_TYPE_F32 || gate->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+        if (!ggml_is_contiguous_1(src0) || !ggml_is_contiguous_1(gate) || !ggml_is_contiguous(dst)) return false;
+        if (!ggml_are_same_shape(src0, gate) || !ggml_are_same_shape(src0, dst)) return false;
+
+        size_t extra_bufs = 0, extra_vmem = 0, extra_tens = 0;
+        auto fit_t = [&](const ggml_tensor * t) {
+            if (!t) return;
+            if (!t_map.count(t)) {
+                extra_tens++;
+                auto sbuf = static_cast<ggml_hexagon_shared_buffer *>(t->buffer->context);
+                if (!b_map.count(sbuf->fd())) {
+                    extra_vmem += sbuf->size();
+                    extra_bufs += 1;
+                }
+            }
+        };
+        fit_t(gate);
+        fit_t(dst);
+        if ((extra_bufs + n_bufs) > n_bufs_max || (extra_tens + n_tens) > n_tens_max || (extra_vmem + b_vmem) > b_vmem_max) {
+            return false;
+        }
+
+        last_node.opcode = HTP_OP_GLU_GEGLU;
+        last_node.name   = "GELU+MUL";
+        last_node.inputs.clear();
+        last_node.inputs.push_back(src0);
+        last_node.inputs.push_back(gate);
+        last_node.outputs.clear();
+        last_node.outputs.push_back(dst);
+        last_node.fused.push_back(node.node);
+        // GLU kernels derive their VTCM layout on-device from the tensor descriptors.
+        memset(last_node.kernel_params, 0, sizeof(last_node.kernel_params));
